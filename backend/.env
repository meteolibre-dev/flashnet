# FlashNet Backend Environment Variables
# Copy this file to .env and modify as needed

# ============================================
# Server Configuration
# ============================================
# Host to bind the server to
SERVER_HOST=0.0.0.0

# Port to listen on
SERVER_PORT=8080

# Enable debug mode (not recommended for production)
SERVER_DEBUG=false

# Enable auto-reload (development only)
SERVER_RELOAD=false

# ============================================
# Model Configuration
# ============================================
# Local path to cached model weights (downloaded from GCS at startup)
MODEL_PATH=/tmp/flashnet_cache/model.safetensors

# GCS path to model weights (downloaded at job startup)
MODEL_GCS_PATH=gs://eumetsat_mtg_preprocess/assets/model_v15_mtg_world_lightning_shortcut_jit_e160.safetensors

# Model type: "jit" or "unet"
MODEL_TYPE=jit

# Patch size for tiled inference
PATCH_SIZE=128

# Number of denoising steps
DENOISING_STEPS=100

# Batch size for inference
BATCH_SIZE=64

# Number of forecast steps to generate
FORECAST_STEPS=18

# Number of frames per forecast batch
NB_FORECAST=3

# Number of context frames
CONTEXT_FRAMES=4

# Use residual connections
USE_RESIDUAL=False

INTERPOLATION=linear

# Seed for reproducible rectified-flow initial noise.
# Change this value to compare different stochastic forecasts.
INFERENCE_SEED=123

# Debug: save endpoint predictions (x0-hat) at these t values during
# the first AR step. Comma-separated. Leave empty to disable.
DEBUG_ENDPOINT_T_VALUES=1.0,0.99,0.98,0.97,0.96,0.95,0.94,0.93,0.92,0.91,0.9,0.8,0.7,0.6,0.5,0.4,0.3,0.2,0.1,0.0

# ============================================
# GCP Configuration
# ============================================
# Source bucket for input H5 files
GCP_SOURCE_BUCKET=eumetsat_mtg_preprocess

# Source prefix path
GCP_SOURCE_PREFIX=inference_h5_past

# Destination bucket for forecast outputs
GCP_DEST_BUCKET=inference_result_meteolibre_forecast

# Destination prefix path
GCP_DEST_PREFIX=forecasts_past

# Path to GCP service account credentials JSON file
# Leave empty to use Application Default Credentials
GCP_CREDENTIALS_PATH=

# GCP project ID
GCP_PROJECT_ID=meteoforecast

# ============================================
# Cache Configuration
# ============================================
# Local cache directory for temporary files
CACHE_DIR=/tmp/flashnet_cache

# Maximum cache size in GB
MAX_CACHE_SIZE_GB=10.0

# Cache expiry time in hours
CACHE_EXPIRY_HOURS=24

# ============================================
# Logging Configuration
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (optional)
LOG_FILE=
